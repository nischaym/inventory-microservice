{
  "name": "inventory-service",
  "version": "0.1.0",
  "private": true,
  "description": "Dealership vehicle inventory service: ingests full-snapshot feeds and serves active/removed inventory.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
